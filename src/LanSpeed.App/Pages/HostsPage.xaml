<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanSpeed.App.Pages.HostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LanSpeed.App.Pages">

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ScanButton" Content="扫描局域网" Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center" Click="OnScan" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="自动扫描" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="AutoScanToggle" OnContent="开" OffContent="关" IsOn="True"
                              Toggled="OnAutoScanToggled" />
            </StackPanel>
            <CheckBox Grid.Column="2" x:Name="ProblemsOnlyCheck" Content="仅问题主机（低于千兆）"
                      VerticalAlignment="Center" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <ProgressRing Grid.Column="3" x:Name="ScanRing" IsActive="False" Width="20" Height="20"
                          VerticalAlignment="Center" />
            <Grid Grid.Column="4" ColumnSpacing="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="链路健康：内网应以千兆为常态。协商低于千兆醒目标记为排查重点（网线 / 交换机口 / 驱动），仍可正常测速。"
                           ToolTipService.ToolTip="内网应以千兆为常态。协商低于千兆的主机会醒目标记为排查重点（网线 / 交换机口 / 驱动），仍可正常测速。" />
            </Grid>
            <TextBlock Grid.Column="5" x:Name="ScanSummary" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <TextBlock x:Name="EmptyHint" Grid.Row="1"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                   Text="尚未扫描：打开本页会自动扫描；也可点击「扫描局域网」。已配对主机会置顶；要测任意两台请到「两机」页。" />

        <Grid Grid.Row="2" ColumnSpacing="12" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="状态" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="IP" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="链路" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="主机名" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="节点名" FontWeight="SemiBold" />
            <TextBlock Grid.Column="5" Text="配对" FontWeight="SemiBold" />
            <TextBlock Grid.Column="6" Text="分组" FontWeight="SemiBold" />
            <TextBlock Grid.Column="7" Text="版本" FontWeight="SemiBold" />
            <TextBlock Grid.Column="8" Text="操作" FontWeight="SemiBold" />
        </Grid>

        <ListView Grid.Row="3" x:Name="HostList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HostRow">
                    <Grid ColumnSpacing="12" Background="{x:Bind RowBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Status}" Foreground="{x:Bind StatusBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Ip}" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{x:Bind LinkBadgeBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind LinkLabel}" FontSize="11" Foreground="White" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{x:Bind Hostname}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{x:Bind NodeName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="5" Text="{x:Bind PairLabel}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Grid.Column="6" Background="{x:Bind GroupBadgeBrush}" CornerRadius="4" Padding="8,2"
                                VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="120"
                                Visibility="{x:Bind GroupBadgeVisibility}">
                            <TextBlock Text="{x:Bind GroupLabel}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Grid.Column="6" Text="{x:Bind GroupLabel}" VerticalAlignment="Center"
                                   Visibility="{x:Bind GroupPlainVisibility}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="7" Text="{x:Bind Version}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6">
                            <Button Content="{x:Bind PairButtonText}" Tag="{x:Bind}" Click="OnTogglePair"
                                    Visibility="{x:Bind PairVisibility}" />
                            <Button Content="测速" Visibility="{x:Bind TestableVisibility}" Tag="{x:Bind Ip}" Click="OnQuickTest" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
