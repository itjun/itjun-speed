<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanSpeed.App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="历史（最近 200 条）" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="导出 CSV" Click="OnExportCsv" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="HistoryList" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="16" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Mode}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Protocol}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding ParamsText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding PairsText}" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="5" Content="删除" Tag="{Binding Id}" Click="OnDelete" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
