<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LanSpeed.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="AcceptSwitch" Header="允许被测" OnContent="允许" OffContent="拒绝" Toggled="OnAcceptToggled" />
                <TextBlock Text="关闭后其他电脑无法对本机发起测速；发现应答仍会显示本机为「拒绝被测」。" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <NumberBox x:Name="PortBox" Header="控制端口" Minimum="1024" Maximum="65535" Value="39301" SpinButtonPlacementMode="Compact" ValueChanged="OnPortChanged" />
                <TextBlock Text="控制接口（TCP）端口；修改后重启程序生效。" Foreground="Gray" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="防火墙与网络" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="自检" Click="OnFirewallCheck" />
                    <Button Content="一键放行（UAC）" Click="OnFirewallFix" />
                </StackPanel>
                <TextBlock x:Name="FirewallText" TextWrapping="Wrap" Foreground="Gray" />
            </StackPanel>

            <StackPanel Spacing="4">
                <ToggleSwitch x:Name="AutoStartSwitch" Header="开机自启" OnContent="开" OffContent="关" Toggled="OnAutoStartToggled" />
                <TextBlock Text="当前用户登录后自动启动并常驻托盘。" Foreground="Gray" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="检查更新" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="检查更新" Click="OnCheckUpdate" />
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="更新源在设置文件 settings.json 的 updateCheckUrl 配置（读取 JSON {&quot;version&quot;:&quot;x.y.z&quot;}）；MSIX 安装版由系统商店/证书更新。" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="VersionText" Foreground="Gray" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Page>
