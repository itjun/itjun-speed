<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>LanSpeed.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <!-- WinUI/XAML 生成代码可能带第三方警告，不参与零警告约束 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- MSIX 打包（§10）：清单声明 StartupTask 与防火墙规则；自签名测试证书在 packaging/，正式发布请换购正式代码签名证书 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <!-- 从当前用户证书存储按指纹签名（pfx 已导入；密码方式在 CI 下不稳定） -->
    <PackageCertificateThumbprint>CC7D82F71BA7DA0A95007270C9A641A8BC8E2C0C</PackageCertificateThumbprint>
    <AppxPackageDir>..\..\packaging\AppPackages\</AppxPackageDir>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanSpeed.Core\LanSpeed.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- iperf3 资源随 App 分发（Windows 节点用） -->
    <Content Include="..\..\assets\iperf3\win64\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\iperf3\win64" />
  </ItemGroup>

</Project>
