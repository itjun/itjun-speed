<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>LanSpeed.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe/任务栏/窗口图标（多尺寸 ico，16–256） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 仅 amd64。不要添加其他 RuntimeIdentifier。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <!-- 自写 Main：先占单实例，再启动 XAML -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- WinUI/XAML 生成代码可能带第三方警告，不参与零警告约束 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 单文件 exe（§10）：Release 不打 MSIX。publish.ps1 打自包含 win-x64 exe。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <WindowsPackageType>None</WindowsPackageType>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!-- 发布脚本传入 LanSpeedPriFile 时，把界面资源嵌进单文件 exe -->
  <ItemGroup Condition="'$(LanSpeedPriFile)' != ''">
    <EmbeddedResource Include="$(LanSpeedPriFile)" LogicalName="LanSpeed.App.pri" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LanSpeed.Core\LanSpeed.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- iperf3 资源随 App 分发（Windows 节点用） -->
    <Content Include="..\..\assets\iperf3\win64\**" CopyToOutputDirectory="PreserveNewest" LinkBase="assets\iperf3\win64" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图标：exe 嵌入 + 托盘/MSIX 运行时可达 -->
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" Exclude="Assets\app-256.png;Assets\app-busy-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\app-256.png;Assets\app-busy-256.png" />
  </ItemGroup>

</Project>
