<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LanSpeed.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="内网测速">

    <Grid>
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsTitleBarAutoPaddingEnabled="False"
            IsSettingsVisible="False"
            OpenPaneLength="190"
            SelectionChanged="OnNavSelection">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主机" Tag="hosts" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="两机" Tag="manual">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="分组" Tag="group">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE902;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="结果" Tag="results">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="历史" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- 托盘（§8）：图标区分状态，菜单含允许被测/中止/退出 -->
        <tb:TaskbarIcon
            x:Name="Tray"
            ToolTipText="内网测速"
            MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="打开主界面" Click="OnShowWindow">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="TrayAccept" Text="允许被测" Click="OnTrayAcceptToggle" />
                    <MenuFlyoutItem Text="中止当前测速" Click="OnStopCurrent">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE71A;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="退出" Click="OnExitApp">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- 窗格宽度拖拽条：拖动实时调整侧栏宽度（160–420），宽度记忆到设置 -->
        <Thumb
            x:Name="PaneResizer"
            Width="7"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Margin="0,48,0,24"
            Background="Transparent"
            PointerEntered="OnResizerPointerEntered"
            PointerExited="OnResizerPointerExited"
            DragDelta="OnResizerDragDelta"
            DragCompleted="OnResizerDragCompleted"
            DoubleTapped="OnResizerDoubleTapped">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="Transparent" CornerRadius="3">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bar.Background" Value="#33007ACC" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bar.Background" Value="#66007ACC" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
